                    <mxGeometry x="800" y="665" width="250" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p1-foundry-evaluators" value="&lt;b&gt;EVALUATOR CATALOG&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Quality + RAG&lt;/b&gt;  coherence, fluency, retrieval, groundedness, relevance, completeness&lt;br&gt;&lt;br&gt;&lt;b&gt;Safety&lt;/b&gt;  hate, sexual, violence, self-harm, protected material, XPIA, code, attributes&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent + tool process&lt;/b&gt;  completion, adherence, intent, navigation, tool selection/input/output/success&lt;br&gt;&lt;br&gt;&lt;b&gt;Domain-specific&lt;/b&gt;  rubric, quality grader, custom versioned evaluators, Azure OpenAI graders&lt;br&gt;&lt;br&gt;&lt;b&gt;Deterministic&lt;/b&gt;  F1, BLEU, GLEU, ROUGE, METEOR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;fontColor=#0C4A6E;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="1080" y="665" width="390" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p1-foundry-runs" value="&lt;b&gt;MANAGED EXECUTION + AUTOMATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Unique run per PR / SHA / release&lt;br&gt;Asynchronous run + polling&lt;br&gt;Foundry schedules&lt;br&gt;Evaluation taxonomies&lt;br&gt;Managed red-team runs&lt;br&gt;Dataset / evaluator generation jobs&lt;br&gt;Agent optimization candidates&lt;br&gt;&lt;br&gt;&lt;b&gt;Preview contracts are version-sensitive&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="1500" y="665" width="290" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p1-foundry-results" value="&lt;b&gt;RESULTS + INSIGHTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Aggregate + per-row scores&lt;br&gt;Pass / fail and defect rates&lt;br&gt;Portal report + deep link&lt;br&gt;Evaluation clustering&lt;br&gt;Agent clustering&lt;br&gt;Run-to-run comparison&lt;br&gt;Baseline delta&lt;br&gt;Latency + token / model cost&lt;br&gt;&lt;br&gt;&lt;b&gt;Feed policy, not automatic retries&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#475569;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="1820" y="665" width="300" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="p1-delivery-lane" value="4  RELEASE DECISION AND PRODUCTION FEEDBACK" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;fillColor=#D9F99D;swimlaneFillColor=#FFFFFF;strokeColor=#BEF264;fontColor=#365314;fontStyle=1;fontSize=15;" parent="p1-1" vertex="1">
                    <mxGeometry x="40" y="1005" width="2120" height="255" as="geometry"/>
                </mxCell>
                <mxCell id="p1-gate" value="&lt;b&gt;AGGREGATE POLICY GATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Deterministic: 100%&lt;br&gt;Safety: 100%&lt;br&gt;Groundedness: &amp;gt;= 95%&lt;br&gt;Relevance: &amp;gt;= 90%&lt;br&gt;Rubric quality: &amp;gt;= 85%&lt;br&gt;No meaningful baseline regression" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7FEE7;strokeColor=#65A30D;strokeWidth=2;fontColor=#365314;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="230" y="1055" width="300" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="p1-pass" value="PASS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;strokeWidth=2;fontColor=#713F12;fontStyle=1;fontSize=13;" parent="p1-1" vertex="1">
                    <mxGeometry x="565" y="1080" width="120" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="p1-approval" value="&lt;b&gt;REQUIRED CHECK + APPROVAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Publish evidence&lt;br&gt;Apply environment protection&lt;br&gt;Record approver and run IDs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;" parent="p1-1" vertex="1">
