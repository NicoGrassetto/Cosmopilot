                <mxCell id="p1-foundry-lane" value="3  MICROSOFT FOUNDRY MANAGED QUALITY PLANE" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;fillColor=#BFDBFE;swimlaneFillColor=#FFFFFF;strokeColor=#93C5FD;fontColor=#1E3A8A;fontStyle=1;fontSize=15;" parent="p1-1" vertex="1">
                    <mxGeometry x="40" y="615" width="2120" height="370" as="geometry"/>
