                <mxCell id="p1-gh-nightly" value="&lt;b&gt;L4  NIGHTLY REGRESSION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Larger datasets&lt;br&gt;Conversation simulation&lt;br&gt;Model / prompt comparisons&lt;br&gt;Sample recent traces&lt;br&gt;&lt;br&gt;&lt;b&gt;ALERT OR ISSUE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;" parent="p1-1" vertex="1">
