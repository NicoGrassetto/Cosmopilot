                <mxCell id="p1-gh-lane" value="2  GITHUB ACTIONS ORCHESTRATION - PROPOSED WORKFLOW SET" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;fillColor=#FED7AA;swimlaneFillColor=#FFFFFF;strokeColor=#FDBA74;fontColor=#7C2D12;fontStyle=1;fontSize=15;" parent="p1-1" vertex="1">
