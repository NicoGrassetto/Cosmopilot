    <diagram id="cosmopilot-feature-map" name="2 - Feature and ownership map">
        <mxGraphModel dx="1250" dy="819" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" background="#F8FAFC" math="0" shadow="0">
            <root>
                <mxCell id="p2-0"/>
                <mxCell id="p2-1" parent="p2-0"/>
                <mxCell id="p2-title" value="Foundry evaluation CI/CD: feature coverage and ownership" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontStyle=1;fontColor=#0F172A;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="22" width="1500" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="p2-subtitle" value="A practical map from Cosmopilot files to GitHub jobs, managed Foundry capabilities, and the evidence each stage must retain." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#475569;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="64" width="1500" height="28" as="geometry"/>
                </mxCell>
                <mxCell id="p2-scope" value="&lt;b&gt;SCOPE&lt;/b&gt;&amp;nbsp;&amp;nbsp; Evaluation-focused CI/CD. azd up provisions infrastructure only; application hosting and deployment are intentionally outside azure.yaml." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=12;align=left;spacingLeft=14;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="105" width="2120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="p2-head-phase" value="LIFECYCLE PHASE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#1E293B;strokeColor=#1E293B;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="160" width="190" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-head-repo" value="COSMOPILOT SOURCE / OWNER" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#0F766E;strokeColor=#0F766E;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="160" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-head-gh" value="GITHUB ACTIONS JOB" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#C2410C;strokeColor=#C2410C;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="160" width="400" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-head-foundry" value="MICROSOFT FOUNDRY CAPABILITY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="160" width="610" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-head-evidence" value="EVIDENCE / DECISION" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#6B21A8;strokeColor=#6B21A8;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="160" width="420" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="p2-phase-foundation" value="&lt;b&gt;FOUNDATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Provision&lt;br&gt;Authenticate&lt;br&gt;Register targets&lt;br&gt;&lt;br&gt;&lt;b&gt;Before L0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;fontSize=13;align=center;verticalAlign=middle;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="220" width="190" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-repo-foundation" value="&lt;b&gt;IN REPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;infra/main.bicep + resources.bicep&lt;br&gt;azure.yaml + postprovision scripts&lt;br&gt;requirements.txt (pinned SDK contracts)&lt;br&gt;src/agents, skills.py, toolboxes.py, routines.py&lt;br&gt;&lt;br&gt;Project, models, Search, Bing, App Insights, agents, prompts, skills and tools are source-controlled." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="220" width="420" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-gh-foundation" value="&lt;b&gt;TARGET: infrastructure-validate.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bicep build / lint / what-if&lt;br&gt;Dependency resolution + SDK contract check&lt;br&gt;azure/login via OIDC&lt;br&gt;Environment-scoped endpoint and deployment vars&lt;br&gt;Least-privilege project role for CI identity&lt;br&gt;&lt;br&gt;Manual azd up remains the infrastructure provisioner." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacing=11;dashed=1;dashPattern=6 4;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="220" width="400" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foundry-foundation" value="&lt;b&gt;GA FOUNDATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Foundry project + managed identity&lt;br&gt;Model and embedding deployments&lt;br&gt;Project connections: Azure AI Search, Bing Grounding, Application Insights&lt;br&gt;Versioned agents and connected tools&lt;br&gt;&lt;br&gt;&lt;b&gt;PREVIEW TARGET ASSETS&lt;/b&gt;&lt;br&gt;Foundry Skills, routines, memory behavior and optimization jobs can be included in target regression coverage." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="220" width="610" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-evidence-foundation" value="&lt;b&gt;PROVISIONING EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bicep compile + what-if artifact&lt;br&gt;Resolved resource and connection IDs&lt;br&gt;Pinned package resolution&lt;br&gt;Agent / model version manifest&lt;br&gt;Smoke invocation result&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision:&lt;/b&gt; environment is eligible for evaluation." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="220" width="420" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-phase-data" value="&lt;b&gt;TEST DATA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Version&lt;br&gt;Validate&lt;br&gt;Generate&lt;br&gt;Simulate&lt;br&gt;&lt;br&gt;&lt;b&gt;L0-L2 / L4-L5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=2;fontColor=#115E59;fontSize=13;align=center;verticalAlign=middle;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="420" width="190" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p2-repo-data" value="&lt;b&gt;IN REPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;data/&amp;lt;scenario&amp;gt;/datasets/&lt;br&gt;  evaluation_dataset.jsonl&lt;br&gt;  golden_dataset.jsonl&lt;br&gt;  validation_dataset.jsonl&lt;br&gt;  synthetic/&lt;br&gt;&lt;br&gt;src/evaluations/datasets.py&lt;br&gt;src/evaluations/evals.py simulators&lt;br&gt;docs/DATA_SOURCE_CONFIGS.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="420" width="420" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p2-gh-data" value="&lt;b&gt;CURRENT: upload-dataset.yml&lt;/b&gt;&lt;br&gt;Changed datasets on main, OIDC, SHA version.&lt;br&gt;&lt;br&gt;&lt;b&gt;TARGET: data-prepare.yml&lt;/b&gt;&lt;br&gt;Validate JSONL + conversation schemas&lt;br&gt;Check duplicates, labels and provenance&lt;br&gt;Select impacted scenario matrix&lt;br&gt;Upload immutable dataset version&lt;br&gt;Optionally start / poll generation jobs&lt;br&gt;Retain a dataset manifest artifact" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="420" width="400" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foundry-data" value="&lt;b&gt;VERSIONED + MANAGED SOURCES&lt;/b&gt;&lt;br&gt;&lt;br&gt;GA: uploaded Foundry dataset versions; JSONL / CSV rows; model and agent target completions; stored response IDs; OpenAI logs&lt;br&gt;&lt;br&gt;&lt;b&gt;PREVIEW&lt;/b&gt;&lt;br&gt;Dataset generation jobs&lt;br&gt;Synthetic query generation&lt;br&gt;Multi-turn conversation simulation&lt;br&gt;Application Insights trace selection&lt;br&gt;Direct and indirect attack simulation&lt;br&gt;Managed red-team source generation&lt;br&gt;&lt;br&gt;Pin dataset, model, agent and prompt versions for reproducibility." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="420" width="610" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p2-evidence-data" value="&lt;b&gt;DATA EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dataset name + immutable version&lt;br&gt;Commit SHA and source paths&lt;br&gt;Schema / row-count report&lt;br&gt;Generation job ID + model version&lt;br&gt;Simulation scenario + seed/config&lt;br&gt;PII / synthetic-data disclosure&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision:&lt;/b&gt; test inputs are valid, attributable and reusable." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="420" width="420" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="p2-phase-eval" value="&lt;b&gt;EVALUATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Define once&lt;br&gt;Run per event&lt;br&gt;Compare baseline&lt;br&gt;Gate aggregates&lt;br&gt;&lt;br&gt;&lt;b&gt;L1-L5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=13;align=center;verticalAlign=middle;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="655" width="190" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p2-repo-eval" value="&lt;b&gt;PARTIAL IMPLEMENTATION SURFACE&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/evaluations/evals.py&lt;br&gt;  register / list / get / delete definitions&lt;br&gt;  direct, indirect and synthetic simulation&lt;br&gt;&lt;br&gt;src/evaluations/&amp;lt;scenario&amp;gt;-evaluations/&lt;br&gt;  create_evaluation.py&lt;br&gt;  run_evaluation.py&lt;br&gt;  create_schedule.py&lt;br&gt;&lt;br&gt;docs/EVALUATORS.md&lt;br&gt;docs/evaluations.md&lt;br&gt;docs/EVALUATION_LIFECYCLE.md&lt;br&gt;&lt;br&gt;Scenario runners are at different maturity levels; CI should call shared, tested entry points." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="655" width="420" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p2-gh-eval" value="&lt;b&gt;TARGET: pr-evaluation.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;L0: unit + deterministic config checks&lt;br&gt;L1: small local evaluator run&lt;br&gt;L2: reconcile stable definitions; start cloud runs&lt;br&gt;L3: smoke pinned target after main&lt;br&gt;&lt;br&gt;Use a matrix by scenario and evaluator-compatible dataset. Name each run with event + SHA. Poll async status with timeout. Retry service / transport failures only.&lt;br&gt;&lt;br&gt;Download result JSON, publish Foundry deep links, annotate the PR and set one aggregate required check.&lt;br&gt;&lt;br&gt;&lt;b&gt;Do not retry a genuine failed score into passing.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacing=11;dashed=1;dashPattern=6 4;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="655" width="400" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foundry-eval" value="&lt;b&gt;REUSABLE DEFINITIONS + UNIQUE MANAGED RUNS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Run sources&lt;/b&gt;  precomputed JSONL / CSV; model target; pinned agent target; stored responses; logs; trace samples; synthetic generation; conversation simulation; managed red team&lt;br&gt;&lt;br&gt;&lt;b&gt;Quality + RAG&lt;/b&gt;  coherence, fluency, similarity, retrieval, document retrieval, groundedness / pro, relevance, response completeness&lt;br&gt;&lt;br&gt;&lt;b&gt;Safety&lt;/b&gt;  hate / unfairness, sexual, violence, self-harm, protected material, indirect attack, code vulnerability, ungrounded attributes, prohibited actions, sensitive-data leakage&lt;br&gt;&lt;br&gt;&lt;b&gt;Agent system + process&lt;/b&gt;  task completion / adherence, satisfaction, intent resolution, navigation efficiency, tool-call accuracy, selection, input accuracy, output utilization and success&lt;br&gt;&lt;br&gt;&lt;b&gt;Domain + deterministic&lt;/b&gt;  rubric, quality grader, versioned custom evaluators, evaluator generation, Azure OpenAI label / string / similarity / score graders, F1 / BLEU / GLEU / ROUGE / METEOR&lt;br&gt;&lt;br&gt;Split runs where input contracts or turn / conversation levels differ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=10;align=left;verticalAlign=top;spacing=10;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="655" width="610" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p2-evidence-eval" value="&lt;b&gt;RUN EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Definition ID + criteria versions&lt;br&gt;Run ID, name, event and commit SHA&lt;br&gt;Target + dataset version manifest&lt;br&gt;Aggregate and per-row metrics&lt;br&gt;Safety defect rates&lt;br&gt;Latency / token / judge-model cost&lt;br&gt;Foundry report deep link&lt;br&gt;JSON artifact retention&lt;br&gt;Baseline and regression delta&lt;br&gt;&lt;br&gt;&lt;b&gt;Suggested aggregate gates&lt;/b&gt;&lt;br&gt;Deterministic + safety: 100%&lt;br&gt;Groundedness: &amp;gt;= 95%&lt;br&gt;Relevance: &amp;gt;= 90%&lt;br&gt;Rubric quality: &amp;gt;= 85%&lt;br&gt;No meaningful main-baseline regression" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="655" width="420" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="p2-phase-assure" value="&lt;b&gt;ASSURE + ANALYZE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schedule&lt;br&gt;Red team&lt;br&gt;Cluster&lt;br&gt;Compare&lt;br&gt;Optimize candidate&lt;br&gt;&lt;br&gt;&lt;b&gt;L4-L5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=13;align=center;verticalAlign=middle;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="1020" width="190" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2-repo-assure" value="&lt;b&gt;IN REPO / PARTIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/evaluations/schedules.py&lt;br&gt;  create, list, get, delete, inspect runs&lt;br&gt;&lt;br&gt;src/evaluations/insights.py&lt;br&gt;  placeholder: client integration still needed&lt;br&gt;&lt;br&gt;src/evaluations/evals.py&lt;br&gt;  direct + indirect attack simulation&lt;br&gt;&lt;br&gt;Human-approval and evidence-grounding skills encode behavioral expectations." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="1020" width="420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2-gh-assure" value="&lt;b&gt;TARGET: scheduled-assurance.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nightly: dispatch / inspect managed schedule&lt;br&gt;Weekly or release: taxonomy + red-team run&lt;br&gt;Generate clustering and comparison insight&lt;br&gt;Open an issue with evidence on regression&lt;br&gt;workflow_dispatch for investigation / rerun&lt;br&gt;Environment approval before release&lt;br&gt;&lt;br&gt;Optimization output creates a candidate PR; it never auto-promotes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacing=11;dashed=1;dashPattern=6 4;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="1020" width="400" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foundry-assure" value="&lt;b&gt;PREVIEW MANAGED OPERATIONS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schedules: recurring evaluation and insight tasks&lt;br&gt;Evaluation taxonomies: reusable risk / behavior coverage&lt;br&gt;Managed red-team service: adversarial target runs&lt;br&gt;Versioned custom evaluators + evaluator-generation jobs&lt;br&gt;Insights: evaluation clustering, agent clustering, run comparison&lt;br&gt;Agent optimization jobs: candidate improvements for a pinned agent&lt;br&gt;&lt;br&gt;Project managed identity requires sufficient project role for scheduled execution." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="1020" width="610" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2-evidence-assure" value="&lt;b&gt;ASSURANCE EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schedule definition + run history&lt;br&gt;Taxonomy and attack-strategy versions&lt;br&gt;Red-team report and defect summary&lt;br&gt;Clusters + representative examples&lt;br&gt;Run comparison against main / release&lt;br&gt;Approver identity and release decision&lt;br&gt;Candidate optimization diff + evaluation&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision:&lt;/b&gt; release, hold, or create remediation work." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="1020" width="420" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="p2-phase-observe" value="&lt;b&gt;OBSERVE + LEARN&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trace&lt;br&gt;Sample&lt;br&gt;Trend&lt;br&gt;Curate&lt;br&gt;&lt;br&gt;&lt;b&gt;L6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontColor=#831843;fontSize=13;align=center;verticalAlign=middle;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="1245" width="190" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-repo-observe" value="&lt;b&gt;IN REPO&lt;/b&gt;&lt;br&gt;&lt;br&gt;src/agents/agents_old.py&lt;br&gt;  OpenTelemetry setup + agent / tool spans&lt;br&gt;&lt;br&gt;infra/resources.bicep&lt;br&gt;  Application Insights&lt;br&gt;  Log Analytics workspace&lt;br&gt;  Foundry project connection&lt;br&gt;&lt;br&gt;The data tree is the destination for reviewed production failures promoted into regression rows." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="250" y="1245" width="420" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-gh-observe" value="&lt;b&gt;TARGET: continuous-evaluation.yml&lt;/b&gt;&lt;br&gt;&lt;br&gt;Select traces by agent version + time window&lt;br&gt;Use random or smart filtering&lt;br&gt;Run turn / conversation evaluation&lt;br&gt;Compare rolling quality and safety trends&lt;br&gt;Create alert / issue; normally do not block traffic&lt;br&gt;Require human review before adding regression rows&lt;br&gt;&lt;br&gt;Link every finding back to trace and evaluation IDs." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=left;verticalAlign=top;spacing=11;dashed=1;dashPattern=6 4;" parent="p2-1" vertex="1">
                    <mxGeometry x="690" y="1245" width="400" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foundry-observe" value="&lt;b&gt;FOUNDRY + AZURE OBSERVABILITY&lt;/b&gt;&lt;br&gt;&lt;br&gt;OpenTelemetry generative-AI traces&lt;br&gt;Application Insights + Log Analytics&lt;br&gt;Foundry trace data source for continuous evaluation&lt;br&gt;Stored responses and conversation IDs&lt;br&gt;Agent / tool process evaluators over sampled traces&lt;br&gt;Azure Monitor alerts and workbooks&lt;br&gt;&lt;br&gt;Evaluate quality, safety, grounding, task / tool success, latency, errors, tokens, cost and drift together." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FDF2F8;strokeColor=#DB2777;strokeWidth=2;fontColor=#831843;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1110" y="1245" width="610" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-evidence-observe" value="&lt;b&gt;OPERATING EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trace / conversation IDs&lt;br&gt;Sampling strategy and time window&lt;br&gt;Rolling score and defect trends&lt;br&gt;Latency / error / tool-success SLOs&lt;br&gt;Alert or issue with representative examples&lt;br&gt;Reviewed regression-row PR&lt;br&gt;&lt;br&gt;&lt;b&gt;Decision:&lt;/b&gt; continue, investigate, roll back a version, or start a reviewed improvement cycle." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=11;align=left;verticalAlign=top;spacing=11;" parent="p2-1" vertex="1">
                    <mxGeometry x="1740" y="1245" width="420" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="p2-footer" value="Status key: teal = implementation surface exists in this repository | blue = current workflow or Foundry GA capability | dashed orange = recommended GitHub automation | purple = preview / managed assurance capability" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#475569;fontStyle=2;" parent="p2-1" vertex="1">
                    <mxGeometry x="40" y="1445" width="2120" height="28" as="geometry"/>
