                <mxCell id="p1-foundry-managed" value="&lt;b&gt;MANAGED + GENERATED SOURCES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Synthetic data generation&lt;br&gt;Conversation simulation&lt;br&gt;Stored responses / logs&lt;br&gt;Application Insights trace samples&lt;br&gt;Adversarial prompts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;fontColor=#6B21A8;fontSize=12;align=left;verticalAlign=top;spacing=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="230" y="810" width="260" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="p1-foundry-targets" value="&lt;b&gt;PINNED RUN TARGETS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Precomputed responses&lt;br&gt;Foundry model deployment&lt;br&gt;Foundry agent + explicit version&lt;br&gt;Tool calls + definitions&lt;br&gt;Stored response IDs&lt;br&gt;Trace conversation IDs&lt;br&gt;&lt;br&gt;Search / Bing / function tools" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=top;spacing=11;" parent="p1-1" vertex="1">
                    <mxGeometry x="520" y="665" width="250" height="280" as="geometry"/>
                </mxCell>
