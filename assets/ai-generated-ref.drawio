                <mxCell id="p1-gh-release" value="&lt;b&gt;L5  RELEASE ASSURANCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Full hosted safety suite&lt;br&gt;Direct + indirect attack simulation&lt;br&gt;Managed red team + taxonomy&lt;br&gt;Compliance evidence + approval&lt;br&gt;&lt;br&gt;&lt;b&gt;REQUIRED FOR RELEASE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFF7ED;strokeColor=#D97706;strokeWidth=2;fontColor=#7C2D12;fontSize=12;align=left;verticalAlign=top;spacing=10;dashed=1;dashPattern=6 4;" parent="p1-1" vertex="1">
