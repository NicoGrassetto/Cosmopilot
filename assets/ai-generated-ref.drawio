                <mxCell id="p1-gh-output" value="&lt;b&gt;CHECKS + EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Required status checks&lt;br&gt;JSON result artifacts&lt;br&gt;Foundry report deep links&lt;br&gt;PR summary + annotations&lt;br&gt;Issue / alert on regression" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontSize=12;align=left;verticalAlign=top;spacing=11;" parent="p1-1" vertex="1">
                    <mxGeometry x="1800" y="420" width="320" height="145" as="geometry"/>
