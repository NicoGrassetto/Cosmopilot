                <mxCell id="p1-foundry-versioned" value="&lt;b&gt;VERSIONED TEST ASSETS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Curated / golden / validation JSONL&lt;br&gt;Immutable Foundry dataset versions&lt;br&gt;Prompt, skill and agent versions&lt;br&gt;Commit SHA provenance" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=12;align=left;verticalAlign=top;spacing=11;" parent="p1-1" vertex="1">
