                <mxCell id="p1-fail-note" value="&lt;b&gt;FAIL:&lt;/b&gt; block the gate, annotate the PR, retain result artifacts, and open an issue for scheduled regressions." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;align=left;spacingLeft=10;" parent="p1-1" vertex="1">
                    <mxGeometry x="365" y="1210" width="585" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="p1-feedback-note" value="Optimization, prompt, evaluator, or dataset changes return as a reviewed pull request. Never mutate the production target directly from a failed score." style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;align=left;spacingLeft=10;" parent="p1-1" vertex="1">
